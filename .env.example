# FirmaClara — Environment Variables
# Copy to .env.local and fill in values. Never commit real secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...   # anon public key (safe to expose)

# ── Stripe (MUST use live keys in production) ────────────────────────────────
VITE_STRIPE_PUBLIC_KEY=pk_live_...     # pk_test_ only for local dev

# ── n8n (backend only — never prefix with VITE_) ────────────────────────────
# Used exclusively by Supabase Edge Functions via Deno.env — not bundled in frontend
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/...
